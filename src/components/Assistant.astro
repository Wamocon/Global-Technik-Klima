---
import { content, biz } from '../content/home'
import type { Locale } from '../i18n/utils'
interface Props { locale: Locale }
const { locale } = Astro.props
const c = content[locale].chat
const wa = `https://wa.me/${biz.whatsapp.replace(/\D/g, '')}`
const ph: Record<Locale, string> = {
  tr: 'Sorunuzu yazın…', ru: 'Напишите вопрос…', de: 'Frage schreiben…', en: 'Type your question…',
}
const send: Record<Locale, string> = { tr: 'Gönder', ru: 'Отправить', de: 'Senden', en: 'Send' }
const waLabel: Record<Locale, string> = { tr: 'WhatsApp’a geç', ru: 'Перейти в WhatsApp', de: 'Zu WhatsApp', en: 'Open WhatsApp' }
---

<button class="chatfab" id="chatfab" aria-label={c.launcher} aria-expanded="false">
  <span class="ci" aria-hidden="true"></span>
  <span class="ct">{c.launcher}</span>
</button>

<div class="chatpanel" id="chatpanel" role="dialog" aria-label="Assistant" hidden
     data-locale={locale} data-wa={wa}>
  <div class="chead">
    <span class="ca" aria-hidden="true"></span>
    <div class="ci-t"><b>Global Teknik</b><span class="on">● {locale === 'ru' ? 'на связи' : locale === 'de' ? 'online' : locale === 'en' ? 'online' : 'çevrimiçi'}</span></div>
    <button class="cclose" id="cclose" aria-label="×">×</button>
  </div>
  <p class="cdisc">{c.disclosure}</p>
  <div class="cbody" id="cbody">
    <div class="msg bot"><span class="b">{c.greeting}</span></div>
  </div>
  <div class="cchips" id="cchips">
    <button type="button" data-q={c.q1}>{c.q1}</button>
    <button type="button" data-q={c.q2}>{c.q2}</button>
    <button type="button" data-q={c.q3}>{c.q3}</button>
  </div>
  <form class="cform" id="cform" autocomplete="off">
    <input id="cin" type="text" placeholder={ph[locale]} aria-label={ph[locale]} />
    <button type="submit" aria-label={send[locale]}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
    </button>
  </form>
</div>

<style>
  .chatfab{position:fixed;right:20px;bottom:20px;z-index:60;display:inline-flex;align-items:center;gap:10px;
    background:var(--accent);color:var(--accent-ink);border:0;border-radius:26px;padding:12px 18px 12px 14px;
    font-family:var(--sans);font-size:.9rem;font-weight:500;cursor:pointer;box-shadow:0 12px 30px rgba(0,0,0,.4)}
  .chatfab .ci{width:20px;height:20px;border-radius:50%;background:var(--noir);display:inline-block;position:relative}
  .chatfab .ci::after{content:"";position:absolute;inset:5px;border-radius:50%;background:var(--cool)}
  @media(max-width:760px){.chatfab{bottom:74px}}

  .chatpanel{position:fixed;right:20px;bottom:78px;z-index:61;width:min(380px,calc(100vw - 32px));
    display:flex;flex-direction:column;max-height:min(620px,calc(100svh - 120px));
    background:var(--bg-3);border:1px solid var(--line-2);border-radius:12px;overflow:hidden;box-shadow:0 30px 70px rgba(0,0,0,.55)}
  /* Höhere Spezifität als .chatpanel, damit [hidden] die display-Regel schlägt (sonst öffnet/schließt es nicht). */
  .chatpanel[hidden]{display:none}
  @media(max-width:760px){.chatpanel{right:12px;left:12px;width:auto;bottom:12px;max-height:calc(100svh - 90px)}}
  .chead{display:flex;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid var(--line);background:var(--bg-2)}
  .chead .ca{width:34px;height:34px;flex:none;border-radius:50%;background:linear-gradient(160deg,var(--champ),var(--gold));position:relative}
  .chead .ca::after{content:"";position:absolute;inset:9px;border:1.5px solid var(--noir);border-radius:2px;transform:rotate(45deg)}
  .ci-t{display:flex;flex-direction:column;line-height:1.2}
  .ci-t b{font-family:var(--serif);font-size:1.12rem;color:var(--fg-strong)}
  .ci-t .on{font-size:.68rem;color:var(--cool);letter-spacing:.02em}
  .cclose{margin-left:auto;cursor:pointer;color:var(--fg-mute);font-size:1.5rem;line-height:1;width:32px;height:32px;
    display:grid;place-items:center;background:none;border:0;border-radius:2px}
  .cclose:hover{color:var(--accent)}
  .cdisc{margin:0;padding:10px 16px;font-size:.72rem;color:var(--fg-mute);border-bottom:1px solid var(--line);
    background:color-mix(in oklab,var(--warn) 6%,transparent)}
  .cbody{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px;min-height:120px}
  .cchips{display:flex;flex-wrap:wrap;gap:7px;padding:0 16px 10px}
  .cchips button{font-size:.76rem;color:var(--accent);background:color-mix(in oklab,var(--accent) 10%,transparent);
    border:1px solid var(--line-2);border-radius:16px;padding:7px 12px;cursor:pointer;min-height:auto;font-family:var(--sans)}
  .cchips button:hover{background:var(--accent);color:var(--accent-ink)}
  .cform{display:flex;gap:8px;padding:12px 14px;border-top:1px solid var(--line);background:var(--bg-2)}
  .cform input{flex:1;min-width:0;background:var(--bg);border:1px solid var(--line-2);color:var(--fg-strong);
    font-family:var(--sans);font-size:.95rem;padding:11px 13px;border-radius:20px;outline:none}
  .cform input:focus{border-color:var(--accent)}
  .cform button{flex:none;width:44px;border-radius:50%;background:var(--accent);color:var(--accent-ink);border:0;
    display:grid;place-items:center;cursor:pointer}
</style>

<!-- Nachrichten werden dynamisch erzeugt → global stylen (scoped greift dort nicht). -->
<style is:global>
  #chatpanel .msg{display:flex;max-width:90%}
  #chatpanel .msg .b{padding:11px 14px;font-size:.92rem;line-height:1.5;border-radius:12px}
  #chatpanel .msg.bot{align-self:flex-start}
  #chatpanel .msg.bot .b{background:var(--card);border:1px solid var(--line);border-top-left-radius:2px;color:var(--fg)}
  #chatpanel .msg.me{align-self:flex-end;margin-left:auto}
  #chatpanel .msg.me .b{background:var(--accent);color:var(--accent-ink);border-top-right-radius:2px}
  #chatpanel .msg.wa{align-self:flex-start}
  #chatpanel .msg.wa a{display:inline-flex;align-items:center;gap:8px;padding:11px 15px;border-radius:12px;border-top-left-radius:2px;
    background:var(--cool);border:0;color:var(--noir);text-decoration:none;font-size:.9rem;font-weight:600}
  #chatpanel .msg.wa a:hover{filter:brightness(1.08)}
  #chatpanel .msg.typing .b{color:var(--fg-mute)}
</style>

<script>
  import {
    INTENTS, PRICE_KW, PRICE_A, HANDOFF_KW, HANDOFF_A, FALLBACK_A,
    AREA_WORDS, BTU_A, WA,
  } from '../content/kb'
  import type { Locale } from '../i18n/utils'

  const panel = document.getElementById('chatpanel') as HTMLElement | null
  const fab = document.getElementById('chatfab') as HTMLButtonElement | null
  if (panel && fab) {
    const locale = (panel.dataset.locale || 'tr') as Locale
    const wa = panel.dataset.wa || `https://wa.me/${WA}`
    const body = document.getElementById('cbody') as HTMLElement
    const form = document.getElementById('cform') as HTMLFormElement
    const input = document.getElementById('cin') as HTMLInputElement
    const chips = document.getElementById('cchips') as HTMLElement
    const close = document.getElementById('cclose') as HTMLButtonElement

    const open = (show: boolean) => {
      panel.hidden = !show
      fab.setAttribute('aria-expanded', String(show))
      if (show) setTimeout(() => input.focus(), 60)
    }
    fab.addEventListener('click', () => open(panel.hidden))
    close.addEventListener('click', () => open(false))
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) open(false) })

    const scroll = () => (body.scrollTop = body.scrollHeight)
    function bubble(text: string, who: 'bot' | 'me') {
      const d = document.createElement('div')
      d.className = `msg ${who}`
      const s = document.createElement('span')
      s.className = 'b'; s.textContent = text
      d.appendChild(s); body.appendChild(d); scroll()
      return d
    }
    function waButton(text: string) {
      const d = document.createElement('div'); d.className = 'msg wa'
      const a = document.createElement('a'); a.href = text; a.target = '_blank'; a.rel = 'noopener'
      a.textContent = { tr: 'WhatsApp’tan yaz', ru: 'Написать в WhatsApp', de: 'Über WhatsApp schreiben', en: 'Message on WhatsApp' }[locale]
      d.appendChild(a); body.appendChild(d); scroll()
    }

    // Türkisch-sichere Kleinschreibung — nie .toLowerCase() (İ/ı-Falle).
    const low = (s: string) => s.toLocaleLowerCase(locale === 'tr' ? 'tr-TR' : locale)
    const hit = (t: string, kws: string[]) => kws.some((k) => t.includes(k))

    function computeBtu(area: number, sun: boolean): string {
      let btu = area * 550 + 0 // Personen unbekannt im Freitext → konservativ
      if (sun) btu *= 1.15
      const step = [9000, 12000, 18000, 24000, 36000, 48000]
      const val = step.reduce((p, s) => (Math.abs(s - btu) < Math.abs(p - btu) ? s : p))
      return val.toLocaleString(locale === 'tr' ? 'tr-TR' : locale)
    }

    // Der lokale Fallback-Verstand: Freitext → beste Absicht.
    function localAnswer(raw: string): { text: string; wa?: string } {
      const t = low(raw)

      // 1) BTU: Zahl + Flächenwort → rechnen
      const areaHit = hit(t, AREA_WORDS)
      const num = t.match(/(\d{2,3})\s*(m2|m²|м2|м²|qm|metre|metrekare|метр|квадрат|square|kare)?/)
      if (areaHit && num) {
        const area = parseInt(num[1], 10)
        if (area >= 6 && area <= 300) {
          const sun = hit(t, ['güney', 'çatı', 'юг', 'верхн', 'süd', 'dach', 'south', 'roof', 'top floor'])
          const btu = computeBtu(area, sun)
          return { text: BTU_A[locale](btu), wa: `${wa}?text=${encodeURIComponent(`${area} m² · ~${btu} BTU`)}` }
        }
      }

      // 2) Mensch / WhatsApp gewünscht
      if (hit(t, HANDOFF_KW) || t.includes('whatsapp')) return { text: HANDOFF_A[locale], wa }

      // 3) Preis
      if (hit(t, PRICE_KW)) return { text: PRICE_A[locale], wa }

      // 4) Absichten nach Trefferzahl gewichtet
      let best: { id: string; score: number } | null = null
      for (const it of INTENTS) {
        let score = 0
        for (const k of it.kw) if (t.includes(k)) score += k.length > 4 ? 2 : 1
        if (score > 0 && (!best || score > best.score)) best = { id: it.id, score }
      }
      if (best) {
        const it = INTENTS.find((x) => x.id === best!.id)!
        // Bei „welche/hangi/какой/which“ + Fläche → in BTU-Frage lenken
        return { text: it.a[locale] }
      }

      // 5) Nichts erkannt → Mensch
      return { text: FALLBACK_A[locale], wa }
    }

    let busy = false
    async function answer(raw: string) {
      if (busy || !raw.trim()) return
      busy = true
      bubble(raw, 'me')
      input.value = ''
      chips.style.display = 'none'
      const typing = bubble('…', 'bot'); typing.classList.add('typing')

      let text = ''
      let waLink: string | undefined
      // Zuerst den echten LLM-Endpunkt versuchen (Produktion, türkischer Server).
      try {
        const r = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ message: raw, locale }),
        })
        if (r.ok) {
          const j = await r.json()
          if (j && j.reply) { text = j.reply; waLink = j.wa }
        }
      } catch { /* offline / kein Endpunkt → lokaler Verstand */ }

      if (!text) { const a = localAnswer(raw); text = a.text; waLink = a.wa }

      await new Promise((res) => setTimeout(res, 260))
      typing.remove()
      bubble(text, 'bot')
      if (waLink) waButton(waLink)
      busy = false
    }

    form.addEventListener('submit', (e) => { e.preventDefault(); answer(input.value) })
    chips.querySelectorAll<HTMLButtonElement>('[data-q]').forEach((b) =>
      b.addEventListener('click', () => answer(b.dataset.q || ''))
    )
  }
</script>
