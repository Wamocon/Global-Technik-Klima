---
// Phase 0 — die Nullsprache sichtbar machen.
//
// Diese Ansicht zeigt jeden Baustein in der Pseudo-Sprache und markiert,
// wo er seine Längengrenze reißt. Sie ist ein Prüfwerkzeug, keine Seite.
// Sie verschwindet, sobald die Prosa einzieht.
import { t, meta, allKeys, invariants, type Locale } from '../i18n/utils'

interface Props {
  locale: Locale
}
const { locale } = Astro.props

const rows = allKeys.map((key) => {
  const m = meta(key)
  const text = t(locale, key, { temperatur: 38, count: invariants.ratingCount, btu: 12000 })
  const over = m.maxLen ? text.length - m.maxLen : 0
  return { key, m, text, over }
})

const overflows = rows.filter((r) => r.over > 0).length
const blocked = rows.filter((r) => r.m.blocked).length
---

<main class="wrap">
  <header class="head">
    <p class="label">Phase 0 · Nullsprache · {locale}</p>
    <h1>Das Layout muss halten, bevor ein Wort übersetzt wird.</h1>
    <p class="lede">
      Jeder Baustein ist gestreckt und mit türkischen Diakritika und Kyrillisch durchsetzt —
      genau den Zeichen, an denen dieses Projekt scheitern kann. Deutsch zeigt die Quelle:
      es ist die Redaktionssprache.
    </p>
    <div class="stats">
      <span><b>{rows.length}</b> Bausteine</span>
      <span class={overflows ? 'bad' : 'ok'}><b>{overflows}</b> reißen ihre Längengrenze</span>
      <span class={blocked ? 'warn' : 'ok'}><b>{blocked}</b> gesperrt bis zum Beleg</span>
    </div>
  </header>

  <!-- Hero-Attrappe: hier bricht Text zuerst. -->
  <section class="hero">
    <p class="label">{t(locale, 'hero.eyebrow')}</p>
    <h2>{t(locale, 'hero.claim')}</h2>
    <p class="sub">{t(locale, 'hero.sub')}</p>
    <div class="ctas">
      <a class="btn btn-primary" href={`https://wa.me/${invariants.whatsapp.replace(/\D/g, '')}`}>
        {t(locale, 'hero.cta.primary')}
      </a>
      <a class="btn" href="#kesif">{t(locale, 'hero.cta.secondary')}</a>
      <a class="btn phone" href={`tel:${invariants.phone.replace(/\s/g, '')}`}>
        {t(locale, 'hero.phone.label')}: {invariants.phone}
      </a>
    </div>
  </section>

  <table>
    <caption>
      Reißt ein Baustein seine Grenze, muss das Layout ihn trotzdem tragen — nicht der Text schrumpfen.
    </caption>
    <thead>
      <tr>
        <th>Schlüssel</th>
        <th>Schicht</th>
        <th>Register</th>
        <th class="n">max</th>
        <th class="n">ist</th>
        <th>Pseudo-Sprache</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr class={r.over > 0 ? 'over' : undefined}>
            <td><code>{r.key}</code>{r.m.blocked && <span class="lock" title={r.m.blocked}>⛔</span>}</td>
            <td><span class={`tier tier-${r.m.tier}`}>{r.m.tier}</span></td>
            <td class="mute">{r.m.register ?? '—'}</td>
            <td class="n mute">{r.m.maxLen ?? '—'}</td>
            <td class="n">{r.text.length}</td>
            <td class="txt">{r.text}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</main>

<style>
  .head { padding: 56px 0 32px; max-width: 68ch; }
  h1 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); line-height: 1.1; margin-bottom: 16px; }
  .lede { color: var(--fg-mute); }
  .stats { display: flex; gap: 26px; flex-wrap: wrap; font-size: 0.82rem; margin-top: 20px; }
  .stats b { font-family: var(--serif); font-size: 1.4rem; color: var(--fg-strong); margin-right: 6px; }
  .ok b { color: var(--cool); }
  .bad b { color: var(--gree-ember); }
  .warn b { color: var(--accent); }

  .hero {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 34px 28px;
    margin: 12px 0 44px;
    background:
      radial-gradient(120% 90% at 82% 4%, color-mix(in oklab, var(--accent) 12%, transparent), transparent 62%),
      radial-gradient(90% 80% at 4% 106%, color-mix(in oklab, var(--cool) 16%, transparent), transparent 64%);
  }
  .hero h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); line-height: 1.12; margin: 14px 0 10px; }
  .hero .sub { color: var(--fg-mute); max-width: 60ch; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 22px; }
  .phone { font-variant-numeric: tabular-nums; }

  table { border-collapse: collapse; width: 100%; font-size: 0.84rem; }
  caption { caption-side: bottom; text-align: left; color: var(--fg-mute); padding-top: 12px; font-size: 0.78rem; }
  th, td { padding: 9px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  thead th { font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-mute); }
  .n { text-align: right; font-variant-numeric: tabular-nums; }
  .mute { color: var(--fg-mute); }
  code { font-family: ui-monospace, Consolas, monospace; font-size: 0.94em; }
  .txt { font-size: 0.82rem; color: var(--fg-mute); max-width: 46ch; }
  tr.over td { background: color-mix(in oklab, var(--gree-ember) 9%, transparent); }
  tr.over .n:last-of-type { color: var(--gree-ember); font-weight: 500; }
  .lock { margin-left: 6px; }
  .tier { font-size: 0.68rem; letter-spacing: 0.1em; padding: 2px 7px; border: 1px solid var(--line-2); border-radius: var(--radius); }
  .tier-stimme { color: var(--accent); }
  .tier-seo { color: var(--gree-ember); }
  .tier-fach { color: var(--cool); }
  .tier-chrome { color: var(--fg-mute); }
</style>
