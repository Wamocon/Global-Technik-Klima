---
import { biz, type HomeContent } from '../content/home'
import type { Locale } from '../i18n/utils'
interface Props { locale: Locale; c: HomeContent }
const { locale, c } = Astro.props
const h = c.hero
const wa = `https://wa.me/${biz.whatsapp.replace(/\D/g, '')}`
const tel = `tel:${biz.phone.replace(/[^\d+]/g, '')}`
---

<header class="hero">
  <canvas id="frost" aria-hidden="true"></canvas>
  <div class="grain" aria-hidden="true"></div>
  <div class="wrap hero-in">
    <p class="eyebrow">{h.eyebrow}</p>
    <h1 class="build">
      <span class="ln"><span>{h.lines[0]}</span></span>
      <span class="ln"><span class="cool">{h.lines[1]}</span></span>
    </h1>
    <div class="hrule" aria-hidden="true"></div>
    <p class="claim">{h.claim}</p>
    <p class="sub">{h.sub}</p>

    <div class="cta">
      <a class="btn btn-primary" href={wa}>{h.ctaPrimary}</a>
      <a class="btn" href="#kesif">{h.ctaSecondary}</a>
    </div>

    <div class="phones">
      <a class="phone" href={tel}><span class="lab">{h.phoneLabel}</span> {biz.phone}</a>
      <a class="phone" href={wa}><span class="lab">{h.waLabel}</span> {biz.whatsapp}</a>
    </div>

    <div class="micro">
      <span class="rate"><b>★ {biz.ratingValue}</b> · {biz.ratingCount} Google</span>
      <span>{c.trust.dealer}</span>
      {c.trust.lang && <span class="langsig">{c.trust.lang}</span>}
      <span>{c.trust.faturali}</span>
    </div>
  </div>
  <div class="scrollcue" aria-hidden="true"><span>{h.scroll}</span><span class="ln2"></span></div>
</header>

<style>
  .hero{position:relative;min-height:min(94svh,880px);display:grid;align-items:end;overflow:hidden;
    border-bottom:1px solid var(--line);isolation:isolate;
    background:
      radial-gradient(120% 86% at 78% 2%, color-mix(in oklab, var(--gold) 16%, transparent), transparent 60%),
      radial-gradient(98% 74% at 2% 106%, color-mix(in oklab, var(--petrol) 48%, transparent), transparent 62%),
      linear-gradient(176deg,#1b1410,var(--bg) 72%)}
  #frost{position:absolute;inset:0;width:100%;height:100%;z-index:0;opacity:0;transition:opacity 1.6s var(--ease)}
  #frost.on{opacity:1}
  .grain{position:absolute;inset:0;z-index:1;pointer-events:none;opacity:.4;mix-blend-mode:overlay;
    background-image:radial-gradient(circle at 1px 1px, color-mix(in oklab, var(--fg) 22%, transparent) 1px, transparent 0);
    background-size:4px 4px}
  .hero-in{position:relative;z-index:2;padding:104px 0 70px}
  .eyebrow{margin-bottom:28px;max-width:600px}
  .build{font-family:var(--serif);font-weight:600;color:var(--fg-strong);
    font-size:clamp(2.6rem,7.2vw,6rem);line-height:.98;letter-spacing:-.02em;margin:0}
  .build .ln{display:block;overflow:hidden}
  .build .ln>span{display:inline-block;transform:translateY(106%);opacity:0;filter:blur(14px);
    animation:settle 1.5s var(--ease) forwards}
  .build .ln:nth-child(2)>span{animation-delay:.15s}
  .build .cool{color:transparent;background:linear-gradient(94deg,var(--gold),var(--champ) 30%,var(--cool) 70%,var(--frost));
    background-size:230% 100%;-webkit-background-clip:text;background-clip:text;animation:sheen 11s linear 2s infinite}
  @keyframes settle{0%{transform:translateY(106%);opacity:0;filter:blur(14px)}60%{opacity:1}100%{transform:translateY(0);opacity:1;filter:blur(0)}}
  @keyframes sheen{to{background-position:230% 0}}
  .hrule{height:1px;width:min(100%,520px);background:linear-gradient(90deg,var(--accent),transparent);
    transform-origin:left;transform:scaleX(0);animation:draw 1.7s var(--ease) .7s forwards;margin:26px 0 22px}
  @keyframes draw{to{transform:scaleX(1)}}
  .claim{font-family:var(--serif);font-size:clamp(1.15rem,2.1vw,1.6rem);color:var(--fg-strong);
    max-width:34ch;margin:0 0 8px;opacity:0;animation:fade 1.2s var(--ease) .95s forwards}
  .sub{color:var(--fg-mute);max-width:52ch;margin:0 0 26px;opacity:0;animation:fade 1.2s var(--ease) 1.1s forwards}
  @keyframes fade{to{opacity:1}}
  .cta{display:flex;gap:12px;flex-wrap:wrap;opacity:0;animation:fade 1.2s var(--ease) 1.2s forwards}
  .phones{display:flex;gap:22px;flex-wrap:wrap;margin-top:22px;opacity:0;animation:fade 1.2s var(--ease) 1.3s forwards}
  .phone{color:var(--fg-strong);text-decoration:none;font-variant-numeric:tabular-nums;font-size:1.05rem;
    display:inline-flex;align-items:baseline;gap:9px}
  .phone .lab{font-size:.64rem;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)}
  .phone:hover{color:var(--accent)}
  .micro{display:flex;flex-wrap:wrap;gap:10px 26px;margin-top:30px;font-size:.8rem;color:var(--fg-mute);
    align-items:center;opacity:0;animation:fade 1.2s var(--ease) 1.45s forwards}
  .micro .rate b{color:var(--cool);font-family:var(--serif);font-size:1.15rem}
  .micro .langsig{color:var(--accent);border:1px solid var(--line-2);padding:3px 9px;border-radius:2px;font-size:.72rem;letter-spacing:.04em}
  .scrollcue{position:absolute;left:24px;bottom:26px;z-index:2;display:flex;align-items:center;gap:12px;
    color:var(--fg-mute);font-size:.66rem;letter-spacing:.2em;text-transform:uppercase;opacity:0;animation:fade 1.4s var(--ease) 1.7s forwards}
  .scrollcue .ln2{width:44px;height:1px;background:var(--line-2)}
  @media (prefers-reduced-motion: reduce){
    .build .ln>span,.claim,.sub,.cta,.phones,.micro,.scrollcue{animation:none;opacity:1;transform:none;filter:none}
    .hrule{transform:scaleX(1);animation:none}#frost{opacity:.5}
  }
</style>

<script>
  const c = document.getElementById('frost') as HTMLCanvasElement | null
  if (c) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)')
    const ctx = c.getContext('2d', { alpha: true })!
    let w = 0, h = 0, dpr = 1, parts: { x: number; y: number; s: number; o: number }[] = [], raf = 0, t = 0, ph = 0
    const HOT = [201, 162, 39], COOL = [88, 199, 192]
    const mix = (a: number, b: number, k: number) => Math.round(a + (b - a) * k)
    const resize = () => {
      dpr = Math.min(devicePixelRatio || 1, 2); w = c.clientWidth; h = c.clientHeight
      c.width = Math.floor(w * dpr); c.height = Math.floor(h * dpr); ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    }
    const seed = () => {
      const n = Math.min(820, Math.round((w * h) / 1700)); parts = []
      for (let i = 0; i < n; i++) parts.push({ x: Math.random() * w, y: Math.random() * h, s: 0.28 + Math.random() * 0.72, o: Math.random() * 6.28 })
    }
    const frame = () => {
      t += 16; if (ph < 1) ph = Math.min(1, ph + 0.0055)
      ctx.clearRect(0, 0, w, h); ctx.globalCompositeOperation = 'lighter'
      const col = `rgb(${mix(HOT[0], COOL[0], ph)},${mix(HOT[1], COOL[1], ph)},${mix(HOT[2], COOL[2], ph)})`
      const turb = 1 - ph, lift = -0.6 * (1 - ph) + 0.12 * ph
      for (const p of parts) {
        p.x += Math.sin(p.y * 0.026 + t * 0.0021 + p.o) * (1.3 * turb + 0.1) * p.s * 0.6
        p.y += lift * (0.5 + p.s)
        if (p.x < -8) p.x = w + 8; else if (p.x > w + 8) p.x = -8
        if (p.y < -8) p.y = h + 8; else if (p.y > h + 8) p.y = -8
        ctx.globalAlpha = (0.05 + p.s * 0.08) * (0.72 + 0.28 * ph)
        ctx.fillStyle = col; ctx.beginPath(); ctx.arc(p.x, p.y, p.s * (1.5 - 0.35 * ph), 0, 6.2832); ctx.fill()
      }
      ctx.globalAlpha = 1; ctx.globalCompositeOperation = 'source-over'; raf = requestAnimationFrame(frame)
    }
    const stop = () => { if (raf) { cancelAnimationFrame(raf); raf = 0 } }
    const still = () => {
      stop(); resize(); seed(); ph = 1; ctx.clearRect(0, 0, w, h)
      ctx.fillStyle = `rgb(${COOL[0]},${COOL[1]},${COOL[2]})`
      for (const p of parts) { ctx.globalAlpha = 0.045 + p.s * 0.06; ctx.beginPath(); ctx.arc(p.x, p.y, p.s * 1.15, 0, 6.2832); ctx.fill() }
      ctx.globalAlpha = 1; c.classList.add('on')
    }
    const start = () => { if (reduce.matches) return still(); stop(); resize(); seed(); ph = 0; c.classList.add('on'); raf = requestAnimationFrame(frame) }
    const boot = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 900 }) : setTimeout(start, 360))
    document.readyState === 'complete' ? boot() : addEventListener('load', boot)
    let rt: number
    addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => (reduce.matches ? still() : (resize(), seed())), 160) })
    reduce.addEventListener('change', () => (reduce.matches ? still() : start()))
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else if (!reduce.matches && !raf) raf = requestAnimationFrame(frame) })
  }
</script>
