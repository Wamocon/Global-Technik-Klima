---
import FrostHero from './FrostHero.astro'
import Assistant from './Assistant.astro'
import ExplodedUnit from './ExplodedUnit.astro'
import BeforeAfter from './BeforeAfter.astro'
import Star from './Star.astro'
import { content, biz, mission } from '../content/home'
import { LEGAL_SLUGS } from '../content/legal'
import { pathFor, type Locale } from '../i18n/utils'
interface Props { locale: Locale }
const { locale } = Astro.props
const c = content[locale]
const m = mission[locale]
const wa = `https://wa.me/${biz.whatsapp.replace(/\D/g, '')}`
const tel = `tel:${biz.phone.replace(/[^\d+]/g, '')}`
const star = '★★★★★'
const mapEmbed = biz.mapEmbed

// Die drei Fußzeilen-Wörter waren bis eben nur Wörter. Jetzt haben sie Seiten. (L7)
const legalLinks = c.footer.legal.map((text, i) => ({ text, href: pathFor(locale, LEGAL_SLUGS[i]) }))
---

<FrostHero locale={locale} c={c} />

<!-- Leistungen -->
<section class="sec" id="hizmetler">
  <div class="wrap">
    <div class="head" data-reveal>
      <p class="eyebrow">{c.services.title}</p>
      <p class="lede">{c.services.intro}</p>
    </div>
    <div class="cards">
      {c.services.items.map((s) => (
        <article class="card" data-reveal data-reveal-group="hizmetler">
          <span class="dot" aria-hidden="true"></span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Produkte -->
<section class="sec sec-alt" id="urunler">
  <div class="wrap">
    <div class="head" data-reveal>
      <p class="eyebrow">{c.products.title}</p>
      <p class="lede">{c.products.intro}</p>
    </div>
    <div class="prods">
      {c.products.lines.map((p) => (
        <article class="prod" data-reveal data-reveal-group="urunler">
          <div class="pimg"><img src={p.img} alt={p.name} loading="lazy" width="225" height="200" /></div>
          <div class="pbody"><span class="pn">{p.name}</span><span class="pt">{p.tag}</span></div>
        </article>
      ))}
    </div>
    <p class="note-line">{c.products.note}</p>
  </div>
</section>

<Star />

<!-- Königs-Kapitel: das Gerät zerlegt sich beim Scrollen (Three.js, lazy). -->
<ExplodedUnit locale={locale} />

<!-- Referanslarımız — die Seite, die auf seiner Website leer ist. -->
<BeforeAfter locale={locale} />

<Star />

<!-- BTU-Rechner -->
<section class="sec" id="kesif">
  <div class="wrap">
    <div class="head" data-reveal>
      <p class="eyebrow">{c.calc.title}</p>
      <p class="hint">{c.calc.hint}</p>
    </div>
    <div class="calc-grid" data-reveal>
    <div class="calc" data-wa={wa} data-suffix={c.calc.resultSuffix} data-cta={c.calc.cta}>
      <label class="q">
        <span>{c.calc.qArea}</span>
        <input type="number" id="ca" min="6" max="200" value="25" inputmode="numeric" />
      </label>
      <label class="q">
        <span>{c.calc.qPeople}</span>
        <input type="number" id="cp" min="1" max="12" value="2" inputmode="numeric" />
      </label>
      <div class="q">
        <span>{c.calc.qSun}</span>
        <div class="toggle" role="group">
          <button type="button" data-sun="1">{c.calc.sunYes}</button>
          <button type="button" data-sun="0" class="on">{c.calc.sunNo}</button>
        </div>
      </div>
      <div class="result">
        <span class="rl">{c.calc.result}</span>
        <span class="rv"><b id="cbtu">12.000</b> {c.calc.resultSuffix}</span>
      </div>
      <a class="btn btn-primary calc-cta" id="ccta" href={wa}>{c.calc.cta}</a>
    </div>
    <figure class="calc-viz">
      <!-- `alt` war "Gree" — für einen Screenreader eine Ansage ohne Inhalt. Das Bild
           schmückt den BTU-Rechner und trägt keine Information, die der Text daneben
           nicht schon sagt. Leeres alt ist hier die richtige Angabe: es nimmt das
           Bild aus dem Vorlesefluss, statt ihn mit einem Markennamen zu unterbrechen. -->
      <img src="/images/unit-teal.webp" alt="" loading="lazy" width="704" height="607" />
    </figure>
    </div>
  </div>
</section>

<!-- Warum wir. Bis eben ohne id — nicht verlinkbar. (F13) -->
<section class="sec sec-alt" id="neden">
  <div class="wrap">
    <div class="head" data-reveal><p class="eyebrow">{c.why.title}</p></div>
    <div class="tiles">
      {c.why.tiles.map((t) => (
        <article class="tile" data-reveal data-reveal-group="neden"><h3>{t.title}</h3><p>{t.text}</p></article>
      ))}
    </div>
    <div class="warranty" data-reveal>
      <span class="wb">{c.warranty.badge}</span>
      <p>{c.warranty.text}</p>
    </div>
  </div>
</section>

<!-- Bewertungen. Bis eben ohne id — nicht verlinkbar. (F13) -->
<section class="sec" id="yorumlar">
  <div class="wrap">
    <div class="head" data-reveal>
      <p class="eyebrow">{c.reviews.title}</p>
      <p class="lede">{c.reviews.sub}</p>
    </div>
    <div class="revs">
      {c.reviews.items.map((r) => (
        <figure class="rev" data-reveal data-reveal-group="yorumlar">
          <span class="stars" aria-hidden="true">{star}</span>
          <blockquote>{r.text}</blockquote>
          <figcaption>— {r.name}{r.place ? `, ${r.place}` : ''}{r.example && <span class="ex">Beispiel</span>}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- Über uns / Hakkımızda -->
<section class="sec sec-alt" id="hakkimizda">
  <div class="wrap about">
    <div class="ab-l" data-reveal>
      <p class="eyebrow">{m.title}</p>
      <p class="ab-text">{m.text}</p>
    </div>
    <div class="ab-r">
      <!-- Der Text im Element IST die Fassung ohne JavaScript. `data-count` läuft nur
           hoch, wenn das Bewegungssystem läuft — sonst steht die Zahl einfach da.
           Nur echte Zahlen zählen: "7/24" und "Gree" bleiben unangetastet. -->
      <div class="ab-stat" data-reveal data-reveal-group="hakkimizda">
        <b data-count="5" data-count-decimals="1" data-count-prefix="★ ">★ {biz.ratingValue}</b>
        <span><b class="ab-n" data-count={biz.ratingCount}>{biz.ratingCount}</b> Google</span>
      </div>
      <div class="ab-stat" data-reveal data-reveal-group="hakkimizda"><b>7/24</b><span>{c.trust.emergency}</span></div>
      <div class="ab-stat" data-reveal data-reveal-group="hakkimizda"><b>Gree</b><span>{c.trust.dealer}</span></div>
    </div>
  </div>
</section>

<!-- Kontakt -->
<section class="sec" id="kontakt">
  <div class="wrap contact">
    <div class="cl" data-reveal>
      <p class="eyebrow">{c.contact.title}</p>
      <p class="lede">{c.contact.sub}</p>
      <div class="cbtns">
        <a class="btn btn-primary" href={wa}>{c.hero.ctaPrimary}</a>
        <a class="btn" href={tel}>{c.hero.phoneLabel} · {biz.phone}</a>
      </div>
      <div class="cr">
        <div class="crow"><span class="lab">{c.hero.phoneLabel}</span><a href={tel}>{biz.phone}</a></div>
        <div class="crow"><span class="lab">WhatsApp</span><a href={wa}>{biz.whatsapp}</a></div>
        <div class="crow"><span class="lab">{c.contact.addressLabel}</span><span>{biz.address}</span></div>
        <div class="crow"><span class="lab">{c.contact.hours}</span><span>{c.contact.hoursNote}</span></div>
      </div>
    </div>
    <!-- Karte: sein echter Google-Place-Eintrag.
         `biz.mapMode` entscheidet. 'embed' = Demo (er wollte die Karte sehen).
         'consent' = Livegang: ein Google-iframe ist eine Übermittlung ins Ausland
         (KVKK Art. 9), also lädt er erst auf Klick. Ein Wort in home.ts umstellen. -->
    <figure class="cmap" data-map={biz.mapMode}>
      {biz.mapMode === 'embed' ? (
        <iframe src={mapEmbed} title="Global Teknik — Alanya" loading="lazy"
          referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      ) : (
        <button class="cmap-load" type="button" data-src={mapEmbed}>
          <span class="cml-pin" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M12 2a7 7 0 00-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 00-7-7zm0 9.5A2.5 2.5 0 1112 6a2.5 2.5 0 010 5.5z"/></svg>
          </span>
          <span class="cml-t">{c.contact.onMap}</span>
          <span class="cml-s">{biz.address}</span>
        </button>
      )}
    </figure>
  </div>
</section>

<Star />

<footer class="foot">
  <div class="wrap footin">
    <div>
      <p class="fd">{c.footer.dealer}</p>
      <p class="fl">
        {legalLinks.map((l, i) => (
          <>
            {i > 0 && <span class="fsep" aria-hidden="true">·</span>}
            <a href={l.href}>{l.text}</a>
          </>
        ))}
      </p>
      <p class="fr">© 2026 · {c.footer.rights}</p>
    </div>
    <div class="fsoc">
      <a href={biz.facebook} target="_blank" rel="noopener" aria-label="Facebook">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M13 22v-8h3l.5-3H13V9c0-.9.3-1.5 1.6-1.5H17V4.8C16.6 4.8 15.4 4.7 14 4.7c-2.6 0-4 1.6-4 4.3V11H7v3h3v8z"/></svg>
      </a>
      <a href={biz.instagram} target="_blank" rel="noopener" aria-label="Instagram">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
    </div>
  </div>
</footer>

<!-- Sticky-Mobil-Leiste: Anruf + WhatsApp, im Daumenbereich (wie die Altseite). -->
<div class="mobar">
  <a href={tel}><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M6.6 10.8a15 15 0 006.6 6.6l2.2-2.2a1 1 0 011-.24 11 11 0 003.4.55 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11 11 0 00.55 3.4 1 1 0 01-.24 1z"/></svg>{c.hero.phoneLabel}</a>
  <a class="mo-wa" href={wa}><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15l-1.4 5 5.1-1.3A10 10 0 1012 2zm5.8 14.2c-.24.68-1.4 1.3-1.9 1.35-.5.05-1.14.07-1.84-.12a13 13 0 01-6.3-5.5c-.48-.82-.78-1.78-.78-2.7 0-.9.47-1.36.64-1.55.17-.19.37-.24.5-.24l.36.01c.12 0 .28-.04.44.34l.62 1.5c.05.12.08.26 0 .42l-.24.36-.35.38c-.11.11-.23.24-.1.47.13.23.58.96 1.25 1.56.86.77 1.58 1 1.8 1.12.23.11.36.09.5-.06l.6-.7c.16-.19.3-.15.5-.08l1.42.67c.2.1.34.14.39.22.05.08.05.53-.19 1.2z"/></svg>WhatsApp</a>
</div>

<!-- Schwebender WhatsApp-Knopf (Desktop; mobil deckt die Sticky-Leiste WhatsApp ab). -->
<a class="wafab" href={wa} target="_blank" rel="noopener" aria-label="WhatsApp">
  <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.35A10 10 0 1012 2zm0 2a8 8 0 016.9 12.05l-.28.46.83 3-3.08-.8-.44.24A8 8 0 1112 4zm-2.9 4.3c-.15 0-.4.06-.6.28-.2.22-.78.76-.78 1.86s.8 2.15.92 2.3c.12.15 1.57 2.5 3.9 3.4 1.94.75 2.34.6 2.76.56.42-.04 1.36-.55 1.55-1.08.2-.53.2-.98.14-1.08-.06-.1-.22-.15-.46-.27l-1.58-.78c-.2-.1-.35-.15-.5.08l-.62.77c-.14.17-.28.19-.5.08-.24-.12-1-.37-1.9-1.18-.7-.62-1.18-1.4-1.32-1.63-.13-.23-.01-.36.1-.47l.35-.4c.11-.14.15-.24.23-.4.08-.15.04-.29-.02-.4l-.75-1.8c-.2-.47-.4-.4-.53-.4z"/></svg>
</a>

<Assistant locale={locale} />

<style>
  /* Die Sektionsprimitive (.sec, .sec-alt, .head, .eyebrow, .lede, .hint) stehen
     jetzt in global.css — sonst blieben sie auf Home.astro gescoped und die anderen
     Sektionsbausteine (ExplodedUnit, BeforeAfter) bekämen sie nie. Hier nur noch die
     Home-eigenen Muster. */
  .cards{display:grid;gap:16px;grid-template-columns:1fr}
  @media(min-width:640px){.cards{grid-template-columns:1fr 1fr}}
  @media(min-width:960px){.cards{grid-template-columns:1fr 1fr 1fr}}
  /* Jetzt, wo --card wirklich eine Fläche ist, trägt ein Schatten auch etwas.
     Vorher lag er auf einem durchsichtigen Kasten und war unsichtbar. */
  .card{background:var(--card);border:1px solid var(--line);border-radius:2px;padding:24px 22px;
    box-shadow:var(--shadow-1);
    transition:border-color var(--dur-slow) var(--ease),transform var(--dur-slow) var(--ease),
      box-shadow var(--dur-slow) var(--ease)}
  .card:hover{border-color:var(--line-2);transform:translateY(var(--lift));box-shadow:var(--shadow-2)}
  .card .dot{display:block;width:22px;height:1px;background:var(--accent);margin-bottom:16px}
  .card h3{font-size:1.24rem;margin-bottom:8px}
  .card p{margin:0;font-size:.94rem;color:var(--fg-mute)}

  .prods{display:grid;gap:14px;grid-template-columns:1fr}
  @media(min-width:640px){.prods{grid-template-columns:1fr 1fr}}
  @media(min-width:960px){.prods{grid-template-columns:1fr 1fr 1fr}}
  .prod{border:1px solid var(--line);border-radius:2px;overflow:hidden;background:var(--grad-plate);
    display:flex;flex-direction:column;box-shadow:var(--shadow-1);
    transition:border-color var(--dur-slow) var(--ease),transform var(--dur-slow) var(--ease),
      box-shadow var(--dur-slow) var(--ease)}
  .prod:hover{border-color:var(--line-2);transform:translateY(var(--lift));box-shadow:var(--shadow-2)}
  /* Die Bildplatte war eine helle Creme-Fläche mit `mix-blend-mode: multiply` —
     gedacht für freigestellte Produktfotos auf Weiß. Die tatsächlichen Bilder sind
     aber randvolle Fotos und Gree-Werbebanner. Auf der Creme-Platte lagen sie
     ausgewaschen und uneinheitlich.
     Jetzt: dunkle Marine-Platte, Bild randvoll, darüber ein Tönungs-Schleier. Der
     Schleier ist der eigentliche Trick — er bindet sehr verschiedene Bildquellen
     an eine gemeinsame Tiefe und nimmt dem eingebrannten Werbetext die Lautstärke.
     ⚠ Ersetzt der Kunde die Banner durch freigestellte Produktfotos, gehört
       `object-fit` zurück auf `contain`. */
  .prod .pimg{aspect-ratio:16/10;background:var(--navy-deep);overflow:hidden;position:relative;
    border-bottom:1px solid var(--line);display:grid;place-items:center}
  .prod .pimg img{width:100%;height:100%;object-fit:cover;filter:saturate(.9) contrast(1.05);
    transform:scale(1.01);
    transition:transform var(--dur-slow) var(--ease),filter var(--dur-slow) var(--ease)}
  .prod:hover .pimg img{transform:scale(1.05);filter:saturate(1) contrast(1.07)}
  .prod .pimg::after{content:"";position:absolute;inset:0;pointer-events:none;
    background:
      linear-gradient(180deg,transparent 38%,color-mix(in oklab,var(--navy-deep) 82%,transparent) 100%),
      radial-gradient(130% 95% at 50% 0%,transparent 52%,color-mix(in oklab,var(--noir) 46%,transparent) 100%)}
  @media (prefers-reduced-motion:reduce){.prod .pimg img,.prod:hover .pimg img{transform:none;transition:none}}
  .prod .pbody{padding:16px 18px 18px;display:flex;flex-direction:column;gap:4px}
  .prod .pn{font-family:var(--serif);font-size:1.24rem;color:var(--fg-strong)}
  .prod .pt{font-size:.8rem;color:var(--fg-mute);letter-spacing:.02em}
  .note-line{margin:22px 0 0;font-size:.86rem;color:var(--fg-mute)}

  .calc-grid{display:grid;gap:24px;align-items:center}
  @media(min-width:900px){.calc-grid{grid-template-columns:1.05fr .95fr}}
  .calc-viz{margin:0;border:1px solid var(--line);border-radius:3px;overflow:hidden;position:relative;
    background:radial-gradient(120% 100% at 50% 0%, color-mix(in oklab,var(--petrol) 40%,transparent), var(--noir) 90%)}
  .calc-viz::after{content:"";position:absolute;inset:0;box-shadow:inset 0 0 90px rgba(0,0,0,.5);pointer-events:none}
  .calc-viz img{display:block;width:100%;height:auto}
  @media(max-width:899px){.calc-viz{display:none}}
  .calc{border:1px solid var(--line-2);border-radius:2px;padding:28px 26px;background:var(--bg-3);display:grid;gap:20px}
  .calc .q{display:flex;flex-direction:column;gap:9px}
  .calc .q>span{font-size:.9rem;color:var(--fg)}
  .calc input{background:var(--bg);border:1px solid var(--line-2);color:var(--fg-strong);font-family:var(--sans);
    font-size:1.05rem;padding:11px 13px;border-radius:2px;width:140px;font-variant-numeric:tabular-nums}
  .calc input:focus{outline:none;border-color:var(--accent)}
  .toggle{display:inline-flex;border:1px solid var(--line-2);border-radius:2px;overflow:hidden;width:max-content}
  .toggle button{background:transparent;color:var(--fg-mute);border:0;padding:10px 22px;font-family:var(--sans);
    font-size:.9rem;cursor:pointer;min-height:44px}
  .toggle button.on{background:var(--accent);color:var(--accent-ink);font-weight:500}
  .result{display:flex;align-items:baseline;gap:12px;border-top:1px solid var(--line);padding-top:20px}
  .result .rl{color:var(--fg-mute);font-size:.9rem}
  .result .rv{font-family:var(--serif);font-size:2.2rem;color:var(--cool);font-variant-numeric:tabular-nums}
  .result .rv b{color:var(--cool)}
  .calc-cta{width:max-content}

  .tiles{display:grid;gap:16px;grid-template-columns:1fr}
  @media(min-width:640px){.tiles{grid-template-columns:1fr 1fr}}
  @media(min-width:960px){.tiles{grid-template-columns:repeat(4,1fr)}}
  .tile{border:1px solid var(--line);border-radius:2px;padding:22px 20px;background:var(--card);
    box-shadow:var(--shadow-1)}
  .tile h3{font-size:1.24rem;margin-bottom:7px}
  .tile p{margin:0;font-size:.9rem;color:var(--fg-mute)}
  /* Der harte 2-px-Akzentbalken links ist raus. Auf einer Seite, die sonst mit
     1-px-Haarlinien in Champagner bei 16 % arbeitet, war er das lauteste Element
     im Textbereich — und die bekannteste Handschrift generischer Oberflächen.
     Stattdessen dieselbe Sprache wie die Hero-Linie (`.hrule`): ein Verlauf, der
     ausläuft. Die Betonung bleibt, das Klischee geht. */
  .warranty{display:flex;gap:20px;align-items:flex-start;margin-top:28px;border:1px solid var(--line);
    border-radius:2px;padding:20px 22px;background:var(--card);position:relative;box-shadow:var(--shadow-1)}
  .warranty::before{content:"";position:absolute;left:0;top:0;bottom:0;width:1px;
    background:linear-gradient(180deg,var(--accent),transparent)}
  /* Auf denselben Schriftgrad wie die übrigen Serifen-Auszeichnungen (1,24rem).
     Vorher lag er mit 1,15rem als einziger Wert zwischen Grundschrift und
     Auszeichnungsgrad — ein Zwischenschritt, den niemand als Stufe wahrnimmt. */
  .warranty .wb{font-family:var(--serif);color:var(--accent);font-size:1.24rem;flex:none}
  .warranty p{margin:0;font-size:.92rem;color:var(--fg-mute);min-width:0}
  @media(max-width:640px){.warranty{flex-direction:column;gap:10px}}

  .revs{display:grid;gap:16px;grid-template-columns:1fr}
  @media(min-width:820px){.revs{grid-template-columns:repeat(3,1fr)}}
  .rev{border:1px solid var(--line);border-radius:2px;padding:24px 22px;margin:0;background:var(--card);
    box-shadow:var(--shadow-1);display:flex;flex-direction:column;gap:12px}
  .rev .stars{color:var(--accent);letter-spacing:.15em;font-size:.9rem}
  .rev blockquote{margin:0;font-family:var(--serif);font-size:1.24rem;line-height:1.4;color:var(--fg-strong);font-style:italic}
  .rev figcaption{font-size:.84rem;color:var(--fg-mute);display:flex;align-items:center;gap:8px}
  .rev .ex{font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--warn);border:1px solid var(--line-2);padding:2px 6px;border-radius:2px}

  /* Über uns */
  .about{display:grid;gap:30px}
  @media(min-width:820px){.about{grid-template-columns:1.4fr .6fr;align-items:center}}
  .ab-text{font-size:1.24rem;line-height:1.6;color:var(--fg);max-width:60ch;margin:0}
  .ab-r{display:grid;gap:14px}
  .ab-stat{border:1px solid var(--line);border-radius:2px;padding:16px 18px;background:var(--card);display:flex;align-items:baseline;gap:12px}
  /* `tabular-nums` ist hier kein Detail: ohne es wandert die Breite jeder Ziffer
     während des Hochzählens und die Zahl zappelt. */
  .ab-stat b{font-family:var(--serif);font-size:1.7rem;color:var(--accent);line-height:1;
    font-variant-numeric:tabular-nums}
  .ab-stat span{font-size:.86rem;color:var(--fg-mute)}
  /* Die kleine Zahl im Beitext darf nicht die große Serifenzahl imitieren. */
  .ab-stat .ab-n{font-family:var(--sans);font-size:inherit;color:var(--fg);font-weight:500;
    font-variant-numeric:tabular-nums}

  .contact{display:grid;gap:30px}
  @media(min-width:820px){.contact{grid-template-columns:1fr 1fr;align-items:start}}
  .cbtns{display:flex;gap:12px;flex-wrap:wrap;margin:22px 0}
  .cr{border:1px solid var(--line);border-radius:2px;padding:8px 22px;background:var(--card)}
  .crow{display:grid;grid-template-columns:110px 1fr;gap:16px;padding:15px 0;border-bottom:1px solid var(--line);align-items:baseline}
  .crow:last-of-type{border-bottom:0}
  .crow .lab{font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
  .crow a{color:var(--fg-strong);text-decoration:none;font-variant-numeric:tabular-nums}
  .crow a:hover{color:var(--accent)}
  .cmap{margin:0;border:1px solid var(--line);border-radius:3px;overflow:hidden;height:440px;position:relative;
    background:radial-gradient(120% 100% at 50% 0%, color-mix(in oklab,var(--petrol) 34%,transparent), var(--noir) 92%)}
  @media(max-width:819px){.cmap{height:320px}}
  /* Klick-zum-Laden (mapMode 'consent'): erst nach Zustimmung verbindet sich der
     Browser mit Google. Muss trotzdem einladend aussehen, nicht wie eine Sperre. */
  .cmap-load{position:absolute;inset:0;width:100%;height:100%;border:0;background:transparent;cursor:pointer;
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;
    font-family:var(--sans);color:var(--fg-mute);text-align:center;padding:24px}
  .cmap-load .cml-pin{color:var(--accent);display:grid;place-items:center}
  .cmap-load .cml-t{color:var(--fg-strong);font-size:1rem;border-bottom:1px solid var(--accent);padding-bottom:3px}
  .cmap-load .cml-s{font-size:.86rem;max-width:32ch;line-height:1.5}
  .cmap-load:hover .cml-t{color:var(--accent)}

  .foot{padding:44px 0 96px;color:var(--fg-mute);font-size:.85rem}
  @media(min-width:760px){.foot{padding-bottom:60px}}
  .footin{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap}
  .foot .fd{color:var(--fg);margin-bottom:10px}
  .foot .fl{margin:0 0 6px;font-size:.8rem;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .foot .fl a{color:var(--fg-mute);text-decoration:none;border-bottom:1px solid transparent}
  .foot .fl a:hover{color:var(--accent);border-bottom-color:var(--accent)}
  .foot .fsep{opacity:.5}
  .foot .fr{margin:0;font-size:.76rem;opacity:.7}
  .fsoc{display:flex;gap:10px}
  .fsoc a{width:40px;height:40px;display:grid;place-items:center;border:1px solid var(--line-2);border-radius:2px;color:var(--fg-mute)}
  .fsoc a:hover{color:var(--accent);border-color:var(--accent)}

  /* Schwebender WhatsApp-Knopf (Desktop) — über dem Chat-Starter. */
  .wafab{position:fixed;right:24px;bottom:84px;z-index:59;width:54px;height:54px;border-radius:50%;
    background:#25d366;color:#fff;display:grid;place-items:center;box-shadow:0 12px 30px rgba(0,0,0,.42);
    transition:transform .25s var(--ease)}
  .wafab:hover{transform:scale(1.06)}
  @media(max-width:760px){.wafab{display:none}}

  /* Sticky-Mobil-Leiste */
  .mobar{position:fixed;left:0;right:0;bottom:0;z-index:55;display:none;grid-template-columns:1fr 1fr;
    background:color-mix(in oklab,var(--bg) 92%,transparent);backdrop-filter:blur(10px);border-top:1px solid var(--line-2)}
  @media(max-width:760px){.mobar{display:grid}}
  .mobar a{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:14px;color:var(--fg-strong);
    text-decoration:none;font-size:.9rem;font-weight:500}
  .mobar a:first-child{border-right:1px solid var(--line)}
  .mobar .mo-wa{background:var(--accent);color:var(--accent-ink)}

  @media (prefers-reduced-motion: reduce){.card:hover,.prod:hover{transform:none}}
</style>

<!-- GLOBAL, mit Absicht: im Zustimmungs-Modus erzeugt JavaScript das iframe. Astros
     gekapselte Stile tragen einen Bauteil-Schlüssel, den ein per createElement
     erzeugtes Element nicht hat — die Regel würde nicht greifen. Genau daran ist
     diese Karte schon einmal gescheitert (sie blieb bei 154 px hängen). -->
<style is:global>
  .cmap iframe{display:block;width:100%;height:100%;border:0;filter:grayscale(.2) contrast(1.03)}
</style>

<script>
  // BTU-Rechner — clientseitig, verlässt den Browser nie.
  // Formel: Zonenkoeffizient (Akdeniz) × m² + Personen-Zuschlag, Südlage/Dach +15 %.
  const box = document.querySelector('.calc') as HTMLElement | null
  if (box) {
    const area = box.querySelector('#ca') as HTMLInputElement
    const ppl = box.querySelector('#cp') as HTMLInputElement
    const out = box.querySelector('#cbtu') as HTMLElement
    const cta = box.querySelector('#ccta') as HTMLAnchorElement
    const wa = box.dataset.wa || ''
    const suffix = box.dataset.suffix || 'BTU'
    let sun = 0
    box.querySelectorAll<HTMLButtonElement>('[data-sun]').forEach((b) => {
      b.addEventListener('click', () => {
        box.querySelectorAll('[data-sun]').forEach((x) => x.classList.remove('on'))
        b.classList.add('on'); sun = Number(b.dataset.sun); calc()
      })
    })
    const STEP = [9000, 12000, 18000, 24000, 36000, 48000]
    const snap = (v: number) => STEP.reduce((p, s) => (Math.abs(s - v) < Math.abs(p - v) ? s : p))
    const calc = () => {
      const a = Math.max(6, Math.min(200, Number(area.value) || 25))
      const p = Math.max(1, Math.min(12, Number(ppl.value) || 2))
      let btu = a * 550 + Math.max(0, p - 2) * 600  // Akdeniz-Koeffizient, coastal + Sonne
      if (sun) btu *= 1.15
      const val = snap(btu)
      out.textContent = val.toLocaleString('tr-TR')
      const msg = `BTU: ${val} ${suffix} · ${a} m² · ${p} kişi/чел./Pers.`
      cta.href = wa ? `${wa}?text=${encodeURIComponent(msg)}` : '#'
    }
    area.addEventListener('input', calc); ppl.addEventListener('input', calc); calc()
  }

  // Karte im Zustimmungs-Modus: erst der Klick verbindet den Browser mit Google.
  // Im Demo-Modus ('embed') existiert dieser Knopf gar nicht — dann passiert hier nichts.
  const mapBtn = document.querySelector('.cmap-load') as HTMLButtonElement | null
  if (mapBtn) {
    mapBtn.addEventListener('click', () => {
      const src = mapBtn.dataset.src
      if (!src) return
      const f = document.createElement('iframe')
      f.src = src
      f.title = 'Global Teknik — Alanya'
      f.loading = 'lazy'
      f.referrerPolicy = 'no-referrer-when-downgrade'
      f.allowFullscreen = true
      mapBtn.replaceWith(f)
    })
  }
</script>
