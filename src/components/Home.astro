---
import FrostHero from './FrostHero.astro'
import { content, biz } from '../content/home'
import type { Locale } from '../i18n/utils'
interface Props { locale: Locale }
const { locale } = Astro.props
const c = content[locale]
const wa = `https://wa.me/${biz.whatsapp.replace(/\D/g, '')}`
const tel = `tel:${biz.phone.replace(/[^\d+]/g, '')}`
const star = '★★★★★'
---

<FrostHero locale={locale} c={c} />

<!-- Trust-Leiste -->
<section class="trustbar">
  <div class="wrap tb">
    <span class="ok">{c.trust.dealer}</span>
    <span class="ok">{c.trust.faturali}</span>
    <span class="ok">{c.trust.emergency}</span>
    {c.trust.lang && <span class="ok hl">{c.trust.lang}</span>}
    <a class="ok rate" href={biz.mapsUrl} target="_blank" rel="noopener"><b>★ {biz.ratingValue}</b> · {biz.ratingCount}</a>
  </div>
</section>

<!-- Leistungen -->
<section class="sec">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{c.services.title}</p>
      <p class="lede">{c.services.intro}</p>
    </div>
    <div class="cards">
      {c.services.items.map((s) => (
        <article class="card">
          <span class="dot" aria-hidden="true"></span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Produkte -->
<section class="sec sec-alt">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{c.products.title}</p>
      <p class="lede">{c.products.intro}</p>
    </div>
    <div class="prods">
      {c.products.lines.map((p) => (
        <div class="prod"><span class="pn">{p.name}</span><span class="pt">{p.tag}</span></div>
      ))}
    </div>
    <p class="note-line">{c.products.note}</p>
  </div>
</section>

<!-- BTU-Rechner -->
<section class="sec" id="kesif">
  <div class="wrap calc-wrap">
    <div class="head">
      <p class="eyebrow">{c.calc.title}</p>
      <p class="hint">{c.calc.hint}</p>
    </div>
    <div class="calc" data-wa={wa} data-suffix={c.calc.resultSuffix} data-cta={c.calc.cta}>
      <label class="q">
        <span>{c.calc.qArea}</span>
        <input type="number" id="ca" min="6" max="200" value="25" inputmode="numeric" />
      </label>
      <label class="q">
        <span>{c.calc.qPeople}</span>
        <input type="number" id="cp" min="1" max="12" value="2" inputmode="numeric" />
      </label>
      <div class="q">
        <span>{c.calc.qSun}</span>
        <div class="toggle" role="group">
          <button type="button" data-sun="1">{c.calc.sunYes}</button>
          <button type="button" data-sun="0" class="on">{c.calc.sunNo}</button>
        </div>
      </div>
      <div class="result">
        <span class="rl">{c.calc.result}</span>
        <span class="rv"><b id="cbtu">12.000</b> {c.calc.resultSuffix}</span>
      </div>
      <a class="btn btn-primary calc-cta" id="ccta" href={wa}>{c.calc.cta}</a>
    </div>
  </div>
</section>

<!-- Warum wir -->
<section class="sec sec-alt">
  <div class="wrap">
    <div class="head"><p class="eyebrow">{c.why.title}</p></div>
    <div class="tiles">
      {c.why.tiles.map((t) => (
        <article class="tile"><h3>{t.title}</h3><p>{t.text}</p></article>
      ))}
    </div>
    <div class="warranty">
      <span class="wb">{c.warranty.badge}</span>
      <p>{c.warranty.text}</p>
    </div>
  </div>
</section>

<!-- Bewertungen -->
<section class="sec">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{c.reviews.title}</p>
      <p class="lede">{c.reviews.sub}</p>
    </div>
    <div class="revs">
      {c.reviews.items.map((r) => (
        <figure class="rev">
          <span class="stars" aria-hidden="true">{star}</span>
          <blockquote>{r.text}</blockquote>
          <figcaption>— {r.name}{r.place ? `, ${r.place}` : ''}{r.example && <span class="ex">Beispiel</span>}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- Kontakt -->
<section class="sec sec-alt" id="kontakt">
  <div class="wrap contact">
    <div class="cl">
      <p class="eyebrow">{c.contact.title}</p>
      <p class="lede">{c.contact.sub}</p>
      <div class="cbtns">
        <a class="btn btn-primary" href={wa}>{c.hero.ctaPrimary}</a>
        <a class="btn" href={tel}>{c.hero.phoneLabel} · {biz.phone}</a>
      </div>
    </div>
    <div class="cr">
      <div class="crow"><span class="lab">{c.hero.phoneLabel}</span><a href={tel}>{biz.phone}</a></div>
      <div class="crow"><span class="lab">WhatsApp</span><a href={wa}>{biz.whatsapp}</a></div>
      <div class="crow"><span class="lab">{c.contact.addressLabel}</span><span>{biz.address}</span></div>
      <div class="crow"><span class="lab">{c.contact.hours}</span><span>{c.contact.hoursNote}</span></div>
      <a class="maplink" href={biz.mapsUrl} target="_blank" rel="noopener">{c.contact.onMap} →</a>
    </div>
  </div>
</section>

<footer class="foot">
  <div class="wrap">
    <p class="fd">{c.footer.dealer}</p>
    <p class="fl">{c.footer.legal.join(' · ')}</p>
    <p class="fr">© 2026 · {c.footer.rights}</p>
  </div>
</footer>

<!-- KI-Chat-Vorschau -->
<button class="chatfab" id="chatfab" aria-label={c.chat.launcher}>
  <span class="ci" aria-hidden="true"></span>
  <span class="ct">{c.chat.launcher}</span>
</button>
<div class="chatpanel" id="chatpanel" hidden>
  <div class="chead"><b>Global Teknik</b><span class="cclose" id="cclose" role="button" tabindex="0" aria-label="×">×</span></div>
  <p class="cdisc">{c.chat.disclosure}</p>
  <div class="cbody"><div class="bubble">{c.chat.greeting}</div></div>
  <div class="cchips">
    <a href={wa}>{c.chat.q1}</a>
    <a href={wa}>{c.chat.q2}</a>
    <a href="#kesif">{c.chat.q3}</a>
  </div>
</div>

<style>
  .wrap{max-width:var(--maxw);margin-inline:auto;padding-inline:24px}
  .sec{padding:82px 0;border-bottom:1px solid var(--line)}
  .sec-alt{background:var(--bg-2)}
  .head{max-width:70ch;margin-bottom:38px;display:flex;flex-direction:column;gap:14px}
  .eyebrow{font-family:var(--serif);font-size:clamp(1.7rem,3.4vw,2.6rem);font-weight:600;color:var(--fg-strong);
    line-height:1.08;letter-spacing:-.01em;text-transform:none;display:block}
  .eyebrow::after{display:none}
  .lede{font-size:1.12rem;color:var(--fg-mute);margin:0;max-width:62ch}
  .hint{font-size:.95rem;color:var(--fg-mute);margin:0;max-width:56ch}

  .trustbar{background:var(--bg-3);border-bottom:1px solid var(--line)}
  .tb{display:flex;flex-wrap:wrap;gap:10px 22px;padding:15px 24px;align-items:center;font-size:.82rem}
  .tb .ok{color:var(--fg-mute);display:inline-flex;align-items:center;gap:7px;text-decoration:none}
  .tb .ok::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--cool)}
  .tb .hl{color:var(--accent)}
  .tb .rate{margin-left:auto;color:var(--fg)}
  .tb .rate::before{display:none}
  .tb .rate b{color:var(--cool);font-family:var(--serif);font-size:1.05rem}

  .cards{display:grid;gap:16px;grid-template-columns:1fr}
  @media(min-width:640px){.cards{grid-template-columns:1fr 1fr}}
  @media(min-width:960px){.cards{grid-template-columns:1fr 1fr 1fr}}
  .card{background:var(--card);border:1px solid var(--line);border-radius:2px;padding:24px 22px;
    transition:border-color .3s var(--ease),transform .3s var(--ease)}
  .card:hover{border-color:var(--line-2);transform:translateY(-2px)}
  .card .dot{display:block;width:22px;height:1px;background:var(--accent);margin-bottom:16px}
  .card h3{font-size:1.18rem;margin-bottom:8px}
  .card p{margin:0;font-size:.94rem;color:var(--fg-mute)}

  .prods{display:grid;gap:12px;grid-template-columns:1fr}
  @media(min-width:640px){.prods{grid-template-columns:1fr 1fr}}
  @media(min-width:960px){.prods{grid-template-columns:1fr 1fr 1fr}}
  .prod{border:1px solid var(--line);border-radius:2px;padding:18px 20px;display:flex;flex-direction:column;gap:5px;background:var(--card)}
  .prod .pn{font-family:var(--serif);font-size:1.2rem;color:var(--fg-strong)}
  .prod .pt{font-size:.82rem;color:var(--fg-mute);letter-spacing:.02em}
  .note-line{margin:20px 0 0;font-size:.86rem;color:var(--fg-mute)}

  .calc-wrap{max-width:720px}
  .calc{border:1px solid var(--line-2);border-radius:2px;padding:28px 26px;background:var(--bg-3);display:grid;gap:20px}
  .calc .q{display:flex;flex-direction:column;gap:9px}
  .calc .q>span{font-size:.9rem;color:var(--fg)}
  .calc input{background:var(--bg);border:1px solid var(--line-2);color:var(--fg-strong);font-family:var(--sans);
    font-size:1.05rem;padding:11px 13px;border-radius:2px;width:140px;font-variant-numeric:tabular-nums}
  .calc input:focus{outline:none;border-color:var(--accent)}
  .toggle{display:inline-flex;border:1px solid var(--line-2);border-radius:2px;overflow:hidden;width:max-content}
  .toggle button{background:transparent;color:var(--fg-mute);border:0;padding:10px 22px;font-family:var(--sans);
    font-size:.9rem;cursor:pointer;min-height:44px}
  .toggle button.on{background:var(--accent);color:var(--accent-ink);font-weight:500}
  .result{display:flex;align-items:baseline;gap:12px;border-top:1px solid var(--line);padding-top:20px}
  .result .rl{color:var(--fg-mute);font-size:.9rem}
  .result .rv{font-family:var(--serif);font-size:2.2rem;color:var(--cool);font-variant-numeric:tabular-nums}
  .result .rv b{color:var(--cool)}
  .calc-cta{width:max-content}

  .tiles{display:grid;gap:16px;grid-template-columns:1fr}
  @media(min-width:640px){.tiles{grid-template-columns:1fr 1fr}}
  @media(min-width:960px){.tiles{grid-template-columns:repeat(4,1fr)}}
  .tile{border:1px solid var(--line);border-radius:2px;padding:22px 20px;background:var(--card)}
  .tile h3{font-size:1.06rem;margin-bottom:7px}
  .tile p{margin:0;font-size:.9rem;color:var(--fg-mute)}
  .warranty{display:flex;gap:20px;align-items:flex-start;margin-top:28px;border:1px solid var(--line);
    border-left:2px solid var(--accent);border-radius:2px;padding:20px 22px;background:var(--card)}
  .warranty .wb{font-family:var(--serif);color:var(--accent);font-size:1.15rem;white-space:nowrap;flex:none}
  .warranty p{margin:0;font-size:.92rem;color:var(--fg-mute)}

  .revs{display:grid;gap:16px;grid-template-columns:1fr}
  @media(min-width:820px){.revs{grid-template-columns:repeat(3,1fr)}}
  .rev{border:1px solid var(--line);border-radius:2px;padding:24px 22px;margin:0;background:var(--card);display:flex;flex-direction:column;gap:12px}
  .rev .stars{color:var(--accent);letter-spacing:.15em;font-size:.9rem}
  .rev blockquote{margin:0;font-family:var(--serif);font-size:1.12rem;line-height:1.4;color:var(--fg-strong);font-style:italic}
  .rev figcaption{font-size:.84rem;color:var(--fg-mute);display:flex;align-items:center;gap:8px}
  .rev .ex{font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--warn);border:1px solid var(--line-2);padding:2px 6px;border-radius:2px}

  .contact{display:grid;gap:30px}
  @media(min-width:820px){.contact{grid-template-columns:1.1fr .9fr;align-items:center}}
  .cbtns{display:flex;gap:12px;flex-wrap:wrap;margin-top:22px}
  .cr{border:1px solid var(--line);border-radius:2px;padding:8px 22px;background:var(--card)}
  .crow{display:grid;grid-template-columns:110px 1fr;gap:16px;padding:15px 0;border-bottom:1px solid var(--line);align-items:baseline}
  .crow:last-of-type{border-bottom:0}
  .crow .lab{font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
  .crow a{color:var(--fg-strong);text-decoration:none;font-variant-numeric:tabular-nums}
  .crow a:hover{color:var(--accent)}
  .maplink{display:inline-block;margin:8px 0 18px;color:var(--cool);text-decoration:none;font-size:.9rem}

  .foot{padding:44px 0 60px;color:var(--fg-mute);font-size:.85rem}
  .foot .fd{color:var(--fg);margin-bottom:10px}
  .foot .fl{margin:0 0 6px;font-size:.8rem}
  .foot .fr{margin:0;font-size:.76rem;opacity:.7}

  /* Chat */
  .chatfab{position:fixed;right:20px;bottom:20px;z-index:60;display:inline-flex;align-items:center;gap:10px;
    background:var(--accent);color:var(--accent-ink);border:0;border-radius:26px;padding:12px 18px 12px 14px;
    font-family:var(--sans);font-size:.9rem;font-weight:500;cursor:pointer;box-shadow:0 12px 30px rgba(0,0,0,.4)}
  .chatfab .ci{width:20px;height:20px;border-radius:50%;background:var(--noir);display:inline-block;position:relative}
  .chatfab .ci::after{content:"";position:absolute;inset:5px;border-radius:50%;background:var(--cool)}
  .chatpanel{position:fixed;right:20px;bottom:78px;z-index:60;width:min(340px,calc(100vw - 32px));
    background:var(--bg-3);border:1px solid var(--line-2);border-radius:10px;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.5)}
  .chead{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--line);background:var(--bg-2)}
  .chead b{font-family:var(--serif);font-size:1.1rem;color:var(--fg-strong)}
  .cclose{cursor:pointer;color:var(--fg-mute);font-size:1.4rem;line-height:1;width:30px;height:30px;display:grid;place-items:center}
  .cdisc{margin:0;padding:12px 16px;font-size:.72rem;color:var(--fg-mute);border-bottom:1px solid var(--line);background:color-mix(in oklab,var(--warn) 6%,transparent)}
  .cbody{padding:18px 16px}
  .bubble{background:var(--card);border:1px solid var(--line);border-radius:2px 12px 12px 12px;padding:12px 14px;font-size:.92rem;color:var(--fg);max-width:88%}
  .cchips{display:flex;flex-wrap:wrap;gap:8px;padding:0 16px 16px}
  .cchips a{font-size:.78rem;color:var(--accent);background:color-mix(in oklab,var(--accent) 10%,transparent);
    border:1px solid var(--line-2);border-radius:16px;padding:7px 12px;text-decoration:none}
  .cchips a:hover{background:var(--accent);color:var(--accent-ink)}

  @media (prefers-reduced-motion: reduce){.card:hover{transform:none}}
</style>

<script>
  // BTU-Rechner — clientseitig, verlässt den Browser nie.
  // Formel: Zonenkoeffizient (Akdeniz) × m² + Personen-Zuschlag, Südlage/Dach +15 %.
  const box = document.querySelector('.calc') as HTMLElement | null
  if (box) {
    const area = box.querySelector('#ca') as HTMLInputElement
    const ppl = box.querySelector('#cp') as HTMLInputElement
    const out = box.querySelector('#cbtu') as HTMLElement
    const cta = box.querySelector('#ccta') as HTMLAnchorElement
    const wa = box.dataset.wa || ''
    const suffix = box.dataset.suffix || 'BTU'
    let sun = 0
    box.querySelectorAll<HTMLButtonElement>('[data-sun]').forEach((b) => {
      b.addEventListener('click', () => {
        box.querySelectorAll('[data-sun]').forEach((x) => x.classList.remove('on'))
        b.classList.add('on'); sun = Number(b.dataset.sun); calc()
      })
    })
    const STEP = [9000, 12000, 18000, 24000, 36000, 48000]
    const snap = (v: number) => STEP.reduce((p, s) => (Math.abs(s - v) < Math.abs(p - v) ? s : p))
    const calc = () => {
      const a = Math.max(6, Math.min(200, Number(area.value) || 25))
      const p = Math.max(1, Math.min(12, Number(ppl.value) || 2))
      let btu = a * 550 + Math.max(0, p - 2) * 600  // Akdeniz-Koeffizient, coastal + Sonne
      if (sun) btu *= 1.15
      const val = snap(btu)
      out.textContent = val.toLocaleString('tr-TR')
      const msg = `BTU: ${val} ${suffix} · ${a} m² · ${p} kişi/чел./Pers.`
      cta.href = wa ? `${wa}?text=${encodeURIComponent(msg)}` : '#'
    }
    area.addEventListener('input', calc); ppl.addEventListener('input', calc); calc()
  }

  // Chat-Vorschau
  const fab = document.getElementById('chatfab')
  const panel = document.getElementById('chatpanel')
  const close = document.getElementById('cclose')
  const toggle = (show: boolean) => { if (panel) panel.hidden = !show }
  fab?.addEventListener('click', () => toggle(panel?.hidden ?? true))
  close?.addEventListener('click', () => toggle(false))
  close?.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') toggle(false) })
</script>
