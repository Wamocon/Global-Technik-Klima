---
// Eine 404 ist keine Sackgasse, sondern eine Weiche. Die Seite kennt die Sprache
// des Besuchers nicht (Astro erzeugt EINE 404 für alle) — deshalb stehen alle vier
// Wege nebeneinander, ohne dass eine Sprache sich wichtiger machen würde.
import Base from '../layouts/Base.astro'
import { pathFor, locales } from '../i18n/utils'
import { biz } from '../content/home'

const wa = `https://wa.me/${biz.whatsapp.replace(/\D/g, '')}`

const ways: Record<(typeof locales)[number], { line: string; cta: string }> = {
  tr: { line: 'Aradığınız sayfa burada değil.', cta: 'Ana sayfa' },
  ru: { line: 'Такой страницы здесь нет.', cta: 'На главную' },
  de: { line: 'Diese Seite gibt es hier nicht.', cta: 'Startseite' },
  en: { line: 'This page is not here.', cta: 'Homepage' },
}
---

<Base locale="tr" title="404 · Global Teknik Klima" path="">
  <section class="nf">
    <div class="wrap">
      <p class="code">404</p>
      <ul class="ways">
        {locales.map((l) => (
          <li lang={l}>
            <span>{ways[l].line}</span>
            <a href={pathFor(l)}>{ways[l].cta} →</a>
          </li>
        ))}
      </ul>
      <a class="btn btn-primary" href={wa}>WhatsApp · {biz.whatsapp}</a>
    </div>
  </section>
</Base>

<style>
  .nf{padding:96px 0 120px}
  .nf .wrap{max-width:var(--maxw);margin-inline:auto;padding-inline:24px}
  .code{font-family:var(--serif);font-size:clamp(4rem,12vw,8rem);line-height:1;color:var(--accent);margin:0 0 34px}
  .ways{list-style:none;margin:0 0 40px;padding:0;display:grid;gap:2px;max-width:60ch}
  .ways li{display:flex;flex-wrap:wrap;align-items:baseline;gap:14px;padding:16px 18px;
    border:1px solid var(--line);border-radius:2px;background:var(--card)}
  .ways span{color:var(--fg-mute);flex:1;min-width:0}
  .ways a{color:var(--fg-strong);text-decoration:none;font-weight:500;white-space:nowrap}
  .ways a:hover{color:var(--accent)}
</style>
